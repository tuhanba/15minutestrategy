# Copy to tools/mt5/env.sh and adjust. Used by run_import.sh, run_tester.sh, run_script.sh.
# Requires WineHQ Wine 10+ and a portable MT5 (see docs/BACKTEST.md "MetaEditor under Wine").
export T="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"          # this folder (scripts, presets)
export WINE=/path/to/wine11/opt/wine-stable/bin/wine
export WINESERVER=/path/to/wine11/opt/wine-stable/bin/wineserver
export WINEPREFIX=/path/to/prefix
export MT5=$WINEPREFIX/drive_c/MT5
export COMMON=$WINEPREFIX/drive_c/users/$USER/AppData/Roaming/MetaQuotes/Terminal/Common
export WINEDEBUG=-all
export WINEDLLOVERRIDES="mscoree,mshtml="
export DISPLAY=:91
