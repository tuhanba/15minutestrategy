; RBOTE + DTBS preset for an Upcomers Ash Turbo 100k account (DEMO / evaluation use), both strategies
; Rules (help.upcomers.com, read 2026-10-24, user must confirm): 2% target, max 7 trading days
; (days with a closed trade) within 30 calendar days, daily loss 3 000 $, 6% trailing floor.
; Risk per trade stays 0.25% until the challenge simulation picks a value (manager D-022: <= 0.35%
; unless Upcomers confirms that passing with a single win is allowed).
; ASSUMPTION: InpStopUnit=0 (PRICE) reads the source "Stop: 10.00" as 10.00 price units.
; Account confirmed 2026-10-25: XAUUSD digits 2, point 0.01 (10.00 price = 1000 points).
InpAllowLiveTrading=false
; REQUIRED outside the Strategy Tester on EVERY account (demo / prop evaluation too):
; set InpLiveConfirmLogin to this account's login number, otherwise the EA refuses to start.
InpLiveConfirmLogin=0
InpMagic=7915790
; both strategies; limits (daily loss, open risk, trailing floor, target, trading days) are account-wide
InpEnableRBOTE=true
InpEnableDTBS=true
InpMagicDTBS=7915791
InpFibLevel=0.79
InpRR=6
InpStopMode=0
InpStopDistance=10.0
InpStopUnit=0
InpRiskPct=0.25
InpMaxRiskPct=0.5
InpDailyLossPct=2.0
; daily limit = 2% of the INITIAL balance (firm rule base: 3% of initial)
InpDailyOnInitial=true
InpMaxOpenRiskPct=0.5
InpMaxTotalDDPct=4.0
InpTrailingDD=true
InpMaxTradesPerDay=3
InpMaxPositions=1
InpMaxPending=1
InpMaxLots=50
; challenge rules ON (EA defaults are 0 = off)
InpProfitTargetPct=2.0
InpMaxTradingDays=7
InpChallengeDays=30
InpScaleEnabled=false
InpEdgeEnabled=false
InpRegimeEnabled=true
InpNewsFilter=true
InpJournal=true
; Upcomers Ash Turbo: 5 $/lot round turn (confirmed from the account, 2026-10-25)
InpCommissionPerLotRT=5.0
; --- DTBS (spec docs/02): 20-bar extension, close-confirmed break, both break directions,
; adaptive stop from the break start (buffer 0.30, stop 0.5..3.0 ATR), 1.5R, H1+H4 ALL agree
InpDtbsExtBars=20
InpDtbsBreakDirs=0
InpDtbsConfirm=0
InpDtbsSlMode=4
InpDtbsSlBuffer=0.30
InpDtbsSlAtrMult=1.5
InpDtbsMinStopATR=0.5
InpDtbsMaxStopATR=3.0
InpDtbsRR=1.5
InpDtbsHtfAgree=0
InpDtbsSwingN=2
InpDtbsHtfSwingN=2
InpDtbsMinLegATR=1.0
InpDtbsMaxLegBars=200
InpDtbsAtrPeriod=14
InpDtbsHtfBars=600
InpDtbsRiskPct=0.25
