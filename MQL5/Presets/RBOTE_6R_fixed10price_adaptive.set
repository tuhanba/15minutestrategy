; RBOTE tester preset: 6R_fixed10price_adaptive (regime policy + profit scaling + edge weighting = EA defaults)
; ASSUMPTION: InpStopUnit=0 (PRICE) reads the source chart's "Stop: 10.00" as 10.00 price units.
; Verify against the source before trusting results. Structural preset ignores the fixed stop.
InpAllowLiveTrading=false
; InpLiveConfirmLogin is ignored in the tester; outside it EVERY account needs it = its login.
InpLiveConfirmLogin=0
InpMagic=7915790
InpFibLevel=0.79
InpRR=6
InpStopMode=0
InpStopDistance=10.0
InpStopUnit=0
InpStructuralBuffer=0.30
InpRequireSlBeyondRb=true
InpRiskPct=0.25
InpDailyLossPct=1.0
; daily limit = % of the initial balance (EA default, Ash Turbo rule base)
InpDailyOnInitial=true
InpMaxOpenRiskPct=0.5
InpMaxTradesPerDay=3
InpMaxPositions=1
InpMaxPending=1
InpOrderExpiryBars=8
InpSlippageTicks=10
InpNewsFilter=true
InpJournal=true
; Upcomers Ash Turbo: 5 $/lot round turn (confirmed from the account, 2026-10-25)
InpCommissionPerLotRT=5.0
; Regime policy = EA defaults (ASSUMPTION): HIGH x0.5, EXTREME skip, LOW x0.5, RANGE x0.5
InpRegimeEnabled=true
InpRegimeAtrLookback=960
InpVolLowThr=0.70
InpVolHighThr=1.50
InpVolExtremeThr=2.50
InpRangeErPeriod=32
InpRangeEr=0.20
InpTradeHighVol=true
InpRiskMultHighVol=0.5
InpRRHighVol=0
InpTradeExtremeVol=false
InpTradeLowVol=true
InpRiskMultLowVol=0.5
InpRRLowVol=0
InpTradeRange=true
InpRiskMultRange=0.5
InpRRRange=0
InpLookbackBars=1200
; Adaptive risk ON (ASSUMPTION, bounded): +2% of realized profit per trade, cap 0.5%,
; base again after 3 losses or 2% below the balance peak; edge weighting after 40 closed trades
InpScaleEnabled=true
InpMaxRiskPct=0.5
InpProfitSharePct=2.0
InpBrakeDDPct=2.0
InpLossReset=3
InpEdgeEnabled=true
InpEdgeMinTrades=40
InpEdgePrior=20
InpEdgeGain=0.15
InpEdgeMinMult=0.5
InpEdgeMaxMult=1.5
; Multi-year backtest: challenge stop rules OFF (otherwise trading stops at +2%)
InpProfitTargetPct=0
InpMaxTradingDays=0
InpChallengeDays=0
InpTrailingDD=false
; tester server clock: -99 = UTC+2 winter / UTC+3 US DST; custom symbols built from UTC data: set 0
InpServerUtcOffset=-99
; Multi-year backtest: total-DD floor OFF (measure DD, do not freeze trading after the first breach)
InpMaxTotalDDPct=0
