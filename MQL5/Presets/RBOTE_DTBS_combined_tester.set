; RBOTE + DTBS tester preset: both strategies in one EA, baseline settings
; RBOTE (off by default) = 6R, FIXED 10.00 stop. DTBS = the strategy under test.
; Risk and limits are account-wide (daily loss, open risk); positions/pending/trades per day per strategy.
; Multi-year research: challenge rules OFF, total-DD floor OFF, commission 5 $/lot.
InpAllowLiveTrading=false
; InpLiveConfirmLogin is ignored in the tester; outside it EVERY account needs it = its login.
InpLiveConfirmLogin=0
InpMagic=7915790
; RBOTE OFF: no edge in 2020-2023 backtest (PF < 1 in every stop variant, D-038). Set true only to compare.
InpEnableRBOTE=false
InpEnableDTBS=true
InpMagicDTBS=7915791
InpFibLevel=0.79
InpRR=6
InpRbStopMode=0
InpStopDistance=10.0
InpRbStopUnit=0
InpStructuralBuffer=0.30
InpMaxStopATR=3.0
InpRequireSlBeyondRb=true
InpRiskPct=0.25
InpDailyLossPct=1.0
; daily limit = % of the initial balance (EA default, Ash Turbo rule base)
InpDailyOnInitial=true
InpMaxOpenRiskPct=0.5
InpMaxTradesPerDay=3
InpMaxPositions=1
InpMaxPending=1
InpOrderExpiryBars=8
InpSlippageTicks=10
InpNewsFilter=true
InpJournal=true
; Upcomers Ash Turbo: 5 $/lot round turn (confirmed from the account, 2026-10-25)
InpCommissionPerLotRT=5.0
; Regime: classify and log only (source baseline) - every regime traded at full risk
InpRegimeEnabled=true
InpTradeHighVol=true
InpRiskMultHighVol=1.0
InpTradeExtremeVol=true
InpTradeLowVol=true
InpRiskMultLowVol=1.0
InpTradeRange=true
InpRiskMultRange=1.0
InpLookbackBars=1200
; Adaptive risk OFF: flat risk so the effect of scaling can be measured separately
InpScaleEnabled=false
InpEdgeEnabled=false
; Multi-year backtest: challenge stop rules OFF (otherwise trading stops at +2%)
InpProfitTargetPct=0
InpMaxTradingDays=0
InpChallengeDays=0
InpTrailingDD=false
; tester server clock: -99 = UTC+2 winter / UTC+3 US DST; custom symbols built from UTC data: set 0
InpServerUtcOffset=-99
; Multi-year backtest: total-DD floor OFF (measure DD, do not freeze trading after the first breach)
InpMaxTotalDDPct=0
; --- DTBS (spec docs/02): 20-bar extension, close-confirmed break, both break directions,
; adaptive stop from the break start (buffer 0.30, stop 0.5..3.0 ATR), 1.5R, H1+H4 ALL agree
InpDtbsExtBars=20
InpDtbsBreakDirs=0
InpDtbsConfirm=0
InpDtbsSlMode=4
InpDtbsSlBuffer=0.30
InpDtbsSlAtrMult=1.5
InpDtbsMinStopATR=0.5
InpDtbsMaxStopATR=3.0
; D-041: context filter (D1 + H4 EMA50 slope with the trade) + 3R. 2020-23 +0.105R PF 1.14, 2024-26 +0.079R PF 1.10.
; NOT validated (acceptance needs PF >= 1.30): demo / tester only.
InpDtbsRR=3.0
InpDtbsCtxFilter=true
InpDtbsCtxEma=50
InpDtbsCtxSlopeBars=5
InpDtbsHtfAgree=0
InpDtbsSwingN=2
InpDtbsHtfSwingN=2
InpDtbsMinLegATR=1.0
InpDtbsMaxLegBars=200
InpDtbsAtrPeriod=14
InpDtbsHtfBars=600
InpDtbsRiskPct=0.25
